# DIGIHOS Production Environment Configuration
# ------------------------------------------------------------------------------
# App Environment & Port
NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (Coolify / Oracle Cloud)
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://digihos_admin:digihos_secure_password_2026@postgres_db:5432/digihos_hospital

# Optional Cloud SSL for Managed Postgres (e.g. AWS RDS / Supabase / Neon)
DATABASE_SSL=false

# Optional PostgreSQL credentials for docker-compose
POSTGRES_USER=digihos_admin
POSTGRES_PASSWORD=digihos_secure_password_2026
POSTGRES_DB=digihos_hospital
